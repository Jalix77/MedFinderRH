# Copie ce fichier en .env.local pour le developpement local et renseigne
# les valeurs reelles. .env.local est ignore par git (voir .gitignore) et ne
# doit JAMAIS etre committe. Ce fichier .env.example ne contient aucun secret.

# --- Supabase (cote client, exposable au navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (cote serveur UNIQUEMENT — jamais importe dans un composant client) ---
# Utilise pour le bootstrap du premier SUPER_ADMIN et les operations systeme
# qui doivent contourner RLS. Ne jamais logger, ne jamais exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
# URL de base de l'application (utilisee pour les redirections d'auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
