# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local stack
supabase/.temp/
supabase/.branches/

# scripts/dump-policies.mjs output — dump brut de l'etat live des policies
# RLS (pg_policies), regenerable a tout moment, jamais une source de verite
# a committer (voir scripts/generate-rls-initplan-fix.mjs qui le consomme).
scripts/.policies-dump.json

# test artifacts
/playwright-report/
/test-results/
